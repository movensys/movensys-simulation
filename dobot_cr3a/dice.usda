#usda 1.0
(
    defaultPrim = "Dice"
    endTimeCode = 0
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

def Xform "Dice" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    float physics:mass = 0.012

    def "Materials"
    {
        def Material "White"
        {
            token outputs:surface.connect = </Dice/Materials/White/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.95, 0.95, 0.95)
                float inputs:roughness = 0.25
                token outputs:surface
            }
        }

        def Material "Black"
        {
            token outputs:surface.connect = </Dice/Materials/Black/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.05, 0.05, 0.05)
                float inputs:roughness = 0.25
                token outputs:surface
            }
        }
    }

    def Cube "Collision" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        uniform token purpose = "guide"
        double size = 0.05
    }

    def Mesh "Body"
    {
        uniform bool doubleSided = 1
